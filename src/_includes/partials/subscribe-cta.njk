<form class="subscribe-form" data-action="{{ site.subscribeApiBase }}/api/subscribe" data-source="{{ site.subscribeSource }}" novalidate>
  <label class="sr-only" for="subscribe-email">Email</label>
  <input class="subscribe-input" type="email" id="subscribe-email" name="email" placeholder="Your email" required autocomplete="email">
  <input class="subscribe-hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">
  <button type="submit" class="subscribe-submit">Subscribe &rarr;</button>
</form>
