<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="theme-color" content="#952D90">
  {% if description %}
  <meta name="description" content="{{ description }}">
  {% endif %}
  {% if ogTitle %}
  <meta property="og:title" content="{{ ogTitle }}">
  <meta property="og:description" content="{{ ogDescription or description }}">
  {% endif %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=IBM+Plex+Mono:wght@400;500;600;700&family=Orbitron:wght@700;800;900&family=Syne:wght@500;600;700;800&display=swap" rel="stylesheet">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/favicon.svg">
  <link rel="stylesheet" href="/css/style.css">
  <script>(function(w,d,e,u,f,l,n){w[f]=w[f]||function(){(w[f].q=w[f].q||[]).push(arguments);},l=d.createElement(e),l.async=1,l.src=u,n=d.getElementsByTagName(e)[0],n.parentNode.insertBefore(l,n);})(window,document,'script','https://assets.mailerlite.com/js/universal.js','ml');ml('account','1709436');</script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('.subscribe-form').forEach(function (form) {
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          var btn = form.querySelector('.subscribe-submit');
          btn.disabled = true;
          btn.textContent = 'Sending\u2026';
          // Use a hidden iframe so the POST is a real form submit (triggers
          // MailerLite's double opt-in flow) without navigating the page.
          var id = 'ml_frame_' + Date.now();
          var frame = document.createElement('iframe');
          frame.name = id;
          frame.style.display = 'none';
          document.body.appendChild(frame);
          form.target = id;
          form.submit();
          setTimeout(function () {
            form.innerHTML = '<p class="subscribe-success">You\u2019re in.</p>';
            document.body.removeChild(frame);
          }, 800);
        });
      });
    });
  </script>
</head>
<body>
{{ content | safe }}
{% include "partials/footer.njk" %}
</body>
</html>
