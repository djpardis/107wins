<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="theme-color" content="#952D90">
  {% if description %}
  <meta name="description" content="{{ description }}">
  {% endif %}
  {% if ogTitle %}
  <meta property="og:title" content="{{ ogTitle }}">
  <meta property="og:description" content="{{ ogDescription or description }}">
  {% endif %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=IBM+Plex+Mono:wght@400;500;600;700&family=Orbitron:wght@700;800;900&family=Syne:wght@500;600;700;800&display=swap" rel="stylesheet">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/favicon.svg">
  <link rel="stylesheet" href="/css/style.css">
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('.subscribe-form').forEach(function (form) {
        var endpoint = form.getAttribute('data-action');
        if (!endpoint) return;
        var source = form.getAttribute('data-source') || '';
        var btn = form.querySelector('.subscribe-submit');
        var emailInput = form.querySelector('input[type="email"]');
        var hpInput = form.querySelector('input[name="website"]');
        var originalLabel = btn ? btn.textContent : 'Subscribe';

        function showError(msg) {
          var existing = form.parentNode.querySelector('.subscribe-error[data-for="' + form.id + '"]') ||
                         (form.nextElementSibling && form.nextElementSibling.classList && form.nextElementSibling.classList.contains('subscribe-error') ? form.nextElementSibling : null);
          if (existing) existing.remove();
          var p = document.createElement('p');
          p.className = 'subscribe-error';
          p.setAttribute('role', 'status');
          if (form.id) p.setAttribute('data-for', form.id);
          p.textContent = msg;
          form.insertAdjacentElement('afterend', p);
        }

        function showSuccess(msg) {
          form.innerHTML = '<p class="subscribe-success">' + msg + '</p>';
          form.classList.add('subscribe-form--done');
        }

        form.addEventListener('submit', function (e) {
          e.preventDefault();
          var email = emailInput && emailInput.value ? emailInput.value.trim() : '';
          if (!email) return;
          if (btn) { btn.disabled = true; btn.textContent = 'Sending\u2026'; }

          var body = {
            email: email,
            source: source,
            website: hpInput ? hpInput.value : ''
          };

          fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify(body),
            credentials: 'omit',
            mode: 'cors'
          }).then(function (res) {
            return res.json().then(function (data) {
              return { status: res.status, data: data || {} };
            }, function () {
              return { status: res.status, data: {} };
            });
          }).then(function (result) {
            var status = result.status;
            var data = result.data;
            if (status === 200 && data.ok) {
              showSuccess(data.state === 'active'
                ? 'You\u2019re already on the list.'
                : 'Check your email to confirm.');
              return;
            }
            var msg;
            if (status === 400 && data.error === 'invalid_email') {
              msg = 'That email looks invalid.';
            } else if (status === 400 && data.error === 'turnstile_failed') {
              msg = 'Spam check failed. Please try again.';
            } else if (status === 429) {
              msg = 'Too many tries — please wait a moment.';
            } else if (status === 502) {
              msg = 'Couldn\u2019t send confirmation. Please try again.';
            } else {
              msg = 'Something went wrong. Please try again.';
            }
            showError(msg);
            if (btn) { btn.disabled = false; btn.textContent = originalLabel; }
          }).catch(function () {
            showError('Network error. Please try again.');
            if (btn) { btn.disabled = false; btn.textContent = originalLabel; }
          });
        });
      });
    });
  </script>
</head>
<body>
{{ content | safe }}
{% include "partials/footer.njk" %}
</body>
</html>
