---
layout: layouts/base.njk
---
{% include "partials/mini-masthead.njk" %}

<main class="container page">
  <p class="post-back"><a class="post-back-link mono" href="/articles/">&larr; Articles</a></p>
  <article class="article">
    {% if page.date %}<p class="mono article-date"><time datetime="{{ page.date | dateIso }}">{{ page.date | datelineShort }}</time></p>{% endif %}
    <h1 class="page-title">{{ title }}</h1>
    {% if description %}<p class="article-standfirst">{{ description }}</p>{% endif %}
    <div class="article-body">
      {{ content | safe }}
    </div>
  </article>
</main>
